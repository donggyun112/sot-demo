# Configure Google Web client origins for the frontend URL. Production uses HTTPS.
SOT_ENVIRONMENT=production
SOT_GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
# Replace with a random signing secret of at least 32 bytes; do not commit .env.
SOT_JWT_SECRET=replace-with-a-random-jwt-signing-secret
# Ordered Pydantic AI model references. JSON is required for tuple settings.
SOT_MODELS=["test"]
SOT_DATABASE_URL=postgresql://sot:sot@db:5432/sot
SOT_CORS_ORIGINS=["http://localhost:3000"]

# Add only the credentials needed by the model references selected above.
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GOOGLE_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me
